# Copy to .env and fill in values. Never commit .env.

# PostgreSQL connection string used by the backend and Alembic
DATABASE_URL=

# Redis connection string used by Celery and caching
REDIS_URL=

# Secret used to sign JWT access tokens (at least 32 random bytes).
# Docker supplies a local-only default when this is empty. Set your own for deployment.
JWT_SECRET=

# Access token lifetime in minutes
JWT_EXPIRY_MINUTES=

# LLM provider name for the AI assistance layer
LLM_PROVIDER=

# LLM model identifier for the AI assistance layer
LLM_MODEL=

# Google AI Studio key used when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Deployment environment name (local, staging, prod)
ENVIRONMENT=
